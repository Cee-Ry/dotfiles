# Git
alias gitI='git init'
alias gitP='gitI && bash $HOME/bash/git-personal.sh'
alias gitS='gitI && bash $HOME/bash/git-school.sh'
alias gs='git status'
alias ga='git add '
alias gc='git commit -m'
alias gp='git push -u origin main'

# Fedora System commands
alias install='sudo dnf install'
alias uninstall='sudo dnf remove'
alias upgrade='sudo dnf upgrade --refresh -y'
alias update='sudo dnf update'
alias dnfclean='sudo dnf clean all && sudo dnf autoremove'

# Flutter Related
alias Pixel_7='flutter emulators --launch Pixel_7'

# WEB DEV alias cmd
alias html='google-chrome index.html > /dev/null 2>&1 & disown'
